root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{py,php}]
indent_size = 4

# The exact bytes that were signed: no final newline, nothing trimmed.
[webhook-signature/fixture/payload.json]
insert_final_newline = false
trim_trailing_whitespace = false
